rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Los usuarios solo pueden crear su propio documento de usuario.
    // Pueden actualizar o eliminar su propio documento.
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Cualquier usuario autenticado puede leer la lista de salas (para el lobby) y crear nuevas salas.
    match /rooms/{roomId} {
      allow read, create: if request.auth != null;
      // Solo el admin puede actualizar o eliminar el documento principal de la sala.
      allow update, delete: if get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;

      // Reglas para la subcolección de jugadores
      match /players/{userId} {
        // Un usuario autenticado puede leer la lista de jugadores si es parte de la sala.
        allow read: if request.auth != null && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
        // Un usuario puede unirse a una sala (crear su propio documento de jugador).
        allow create: if request.auth.uid == userId;
        // Un usuario puede actualizar/eliminar su propio documento de jugador, o el admin puede hacerlo.
        allow update, delete: if request.auth.uid == userId || get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
      }
      
      // Reglas para la subcolección de selecciones
      match /picks/{pickId} {
        // Un usuario autenticado puede leer la lista de selecciones si es parte de la sala.
        allow read: if request.auth != null && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
        // Un jugador en la sala puede crear/actualizar una selección (la lógica del juego maneja los turnos).
        allow create, update: if request.auth != null && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
        // Solo el admin de la sala puede eliminar selecciones.
        allow delete: if get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
      }
    }
  }
}
