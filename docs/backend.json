{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system.",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "description": "Email address of the user.", "format": "email" },
        "nickname": { "type": "string", "description": "Nickname of the user. Must be unique." },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email", "nickname"]
    },
    "Character": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Character",
      "type": "object",
      "description": "Represents a playable character.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "role", "image"]
    },
    "SuperArt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SuperArt",
      "type": "object",
      "description": "Represents a Super Art ability.",
      "properties": {
        "id": { "type": "string" },
        "characterId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string", "enum": ["red", "yellow", "blue"] },
        "roman": { "type": "string" }
      },
      "required": ["id", "characterId", "name", "description", "color", "roman"]
    },
    "GameData": {
       "$schema": "http://json-schema.org/draft-07/schema#",
       "title": "GameData",
       "type": "object",
       "description": "A single document containing all static game data.",
       "properties": {
         "characters": {
           "type": "array",
           "items": { "$ref": "#/entities/Character" }
         },
         "super_arts": {
           "type": "array",
           "items": { "$ref": "#/entities/SuperArt" }
         }
       }
    },
    "Room": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Room",
      "type": "object",
      "description": "Represents a draft room. Player and pick data are stored in subcollections.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the room." },
        "name": { "type": "string", "description": "Name of the room." },
        "adminId": { "type": "string", "description": "UID of the user who created the room." },
        "team1Name": { "type": "string" },
        "team2Name": { "type": "string" },
        "team1Logo": { "type": "string" },
        "team2Logo": { "type": "string" },
        "playersPerTeam": { "type": "number" },
        "spectatorLimit": { "type": "number" },
        "phase": { "type": "string", "enum": ["PREP", "COIN_FLIP", "DRAFTING", "SUPER_ART", "REVEAL", "FINISHED", "CANCELED"] },
        "firstPicker": { "type": "string", "enum": ["team1", "team2"] },
        "currentPicker": { "type": "string", "enum": ["team1", "team2"] },
        "turn": { "type": "number" },
        "turnEndsAt": { "type": "number" }
      },
      "required": [ "id", "name", "adminId", "team1Name", "team2Name", "team1Logo", "team2Logo", "playersPerTeam", "spectatorLimit", "phase" ]
    },
    "RoomPlayer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RoomPlayer",
      "type": "object",
      "description": "Represents a player's presence in a room.",
      "properties": {
        "uid": { "type": "string", "description": "User ID of the player." },
        "nickname": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "team": { "type": "string", "description": "The team the player is on (e.g., 'team1', 'team2', 'spectator')." },
        "isReady": { "type": "boolean" }
      },
      "required": ["uid", "nickname", "team", "isReady"]
    },
    "DraftPick": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DraftPick",
      "type": "object",
      "description": "Represents a character selection during the draft.",
      "properties": {
        "id": { "type": "string" },
        "characterId": { "type": "string" },
        "pickedBy": { "type": "string" },
        "nickname": { "type": "string"},
        "team": { "type": "string" },
        "pickOrder": { "type": "number" },
        "turn": { "type": "number" },
        "superArtId": { "type": "string" }
      },
      "required": ["id", "characterId", "pickedBy", "team", "pickOrder", "turn"]
    }
  },
  "auth": { "providers": ["password"] },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles. Each document contains user-specific information."
    },
    "/game_data/static": {
      "schema": { "$ref": "#/entities/GameData"},
      "description": "A single document to hold all static game data like characters and super arts."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Stores the core configuration and state for a draft room."
    },
    "/rooms/{roomId}/players/{userId}": {
      "schema": { "$ref": "#/entities/RoomPlayer" },
      "description": "Subcollection for players in a room. Document ID is the user's UID."
    },
     "/rooms/{roomId}/picks/{userId}": {
      "schema": { "$ref": "#/entities/DraftPick" },
      "description": "Subcollection for draft picks in a room. Document ID is the user's UID."
    }
  }
}
