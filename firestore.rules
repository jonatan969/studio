
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Read Rule ---
    // This single rule grants read access to ALL documents and subcollections
    // for any authenticated user. This will definitively solve the permission errors.
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // --- Specific Write Rules ---

    // Users can only create their own user document.
    // They can update or delete their own document.
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow update, delete: if request.auth.uid == userId;
    }
    
    // Room-specific write rules
    match /rooms/{roomId} {
      // Any authenticated user can create a room.
      allow create: if request.auth != null;
      // Only the room admin can update or delete the room document itself.
      allow update, delete: if get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;

      // Player subcollection write rules
      match /players/{userId} {
        // A user can only join a room as themselves.
        allow create: if request.auth.uid == userId;
        // A user can update/delete their own player document, or the admin can.
        allow update, delete: if request.auth.uid == userId || get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
      }
      
      // Picks subcollection write rules
      match /picks/{pickId} {
        // Any authenticated user in the room can create/update a pick (game logic handles turns).
        allow create, update: if request.auth != null && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
        // Only the room admin can delete picks.
        allow delete: if get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
      }
    }
  }
}
