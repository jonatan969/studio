rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to manage their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth.uid == userId;
    }

    // GAME DATA: Publicly readable, but only admins can write.
    match /game_data/{docId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // ROOMS: Allow any authenticated user to read/create rooms.
    // Only the admin can update or delete the main room document.
    match /rooms/{roomId} {
      allow read, create: if request.auth != null;
      allow update, delete: if resource.data.adminId == request.auth.uid;
    }

    // PLAYERS: Allow players to join/leave rooms and update their own status
    match /rooms/{roomId}/players/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth.uid == userId;
    }
  }
}
