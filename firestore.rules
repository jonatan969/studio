rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección 'users'
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Reglas para la colección 'rooms'
    match /rooms/{roomId} {
      // Cualquiera autenticado puede leer datos de una sala o la lista de salas
      allow read: if request.auth != null;
      
      // Cualquiera autenticado puede crear una nueva sala
      allow create: if request.auth != null;

      // Cualquiera autenticado puede actualizar los datos principales de la sala (fase, turno, etc.)
      allow update: if request.auth != null;

      // Reglas para la subcolección de jugadores
      match /players/{userId} {
        allow read: if request.auth != null;

        // Un usuario solo puede crear, actualizar o borrar su propio documento en la subcolección de jugadores.
        // Esto le permite unirse a la sala, cambiar de equipo o salir.
        allow write: if request.auth.uid == userId;
      }

      // Reglas para la subcolección de selecciones
      match /picks/{userId} {
        // Cualquiera autenticado puede leer las selecciones individuales.
        allow read: if request.auth != null;

        // Un usuario solo puede crear o actualizar su propia selección.
        // El ID del documento debe ser su UID.
        allow create, update: if request.auth.uid == userId;
      }
    }
  }
}
