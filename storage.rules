rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for profile photos
    match /profile-photos/{userId} {
      // Allow read access to everyone for profile pictures.
      allow read: if true;
      
      // Allow write access (create, update, delete) only to the authenticated user
      // who owns the profile picture. The uploaded file size must be less than 5MB.
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
