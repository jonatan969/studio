rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global read access for any authenticated user.
    allow read: if request.auth != null;

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Read is covered by global rule.
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if request.auth.uid == userId || isAdmin();
    }

    match /characters/{characterId} {
      // Read is covered by global rule.
      allow write: if isAdmin();
    }

    match /super_arts/{superArtId} {
      // Read is covered by global rule.
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      // Read is covered by global rule.
      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;
      allow update: if request.auth != null && get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;

      match /players/{userId} {
        // Read is covered by global rule.
        allow create: if request.auth.uid == userId;
        allow update: if request.auth.uid == userId || get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
        allow delete: if request.auth.uid == userId || get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
      }

      match /picks/{pickId} {
        // Read is covered by global rule.
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
      }
    }
  }
}
