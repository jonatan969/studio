rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    match /game_data/{docId} {
        allow read: if true; // Everyone can read game data
        allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /rooms/{roomId} {
      allow list, read, create: if request.auth != null;
      // Any authenticated user can update the room's core data (phase, turn, etc.)
      allow update: if request.auth != null;

      // Rules for the 'players' subcollection
      match /players/{userId} {
        // Any authenticated user can see who is in the room.
        allow list, read: if request.auth != null;
        
        // A user can only create, update, or delete their OWN player document.
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Rules for the 'picks' subcollection
      match /picks/{userId} {
         // Any authenticated user can see the picks.
        allow list, read: if request.auth != null;

        // A user can only create or update their own pick document.
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
