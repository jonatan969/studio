rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isRoomAdmin(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
    }

    function isParticipant(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }
    
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /characters/{characterId} {
      allow read: if isSignedIn();
      // Solo un administrador podría escribir/actualizar personajes en el futuro
      // allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 2;
    }

    match /super_arts/{superArtId} {
      allow read: if isSignedIn();
      // Solo un administrador podría escribir/actualizar super arts en el futuro
      // allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 2;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && isRoomAdmin(roomId);
      allow delete: if isSignedIn() && isRoomAdmin(roomId);
      
      match /players/{userId} {
        allow read: if true;
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isRoomAdmin(roomId);
        allow delete: if isOwner(userId) || isRoomAdmin(roomId);
      }
      
      match /picks/{pickId} {
        allow read: if isParticipant(roomId); // read includes get and list
        allow create: if isParticipant(roomId);
        allow update: if isParticipant(roomId);
        allow delete: if isRoomAdmin(roomId);
      }
    }
  }
}
